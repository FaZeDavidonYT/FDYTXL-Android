name: Build FDYTXL Android APK (phone only)

on:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build installable FDYTXL debug APK
    runs-on: ubuntu-latest
    steps:
      - name: Get uploaded ZIP
        uses: actions/checkout@v4

      - name: Install Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install SDK API 36
        run: sdkmanager "platforms;android-36" "build-tools;35.0.0"

      - name: Set up Gradle 8.13
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.13'

      - name: Extract uploaded FDYTXL source ZIP
        run: |
          mkdir -p workspace
          unzip -q FDYTXL-Android-source.zip -d workspace
          test -f workspace/FDYTXL-Android/app/build.gradle

      - name: Build FDYTXL APK
        working-directory: workspace/FDYTXL-Android
        run: gradle --no-daemon --stacktrace :app:assembleDebug

      - name: Downloadable APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: FDYTXL-Android-debug-APK
          path: workspace/FDYTXL-Android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
